orPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566839110,"textPrimary":4281862151,"textSecondary":4286458666,"invertedBackground":4287568665,"overlayBackground":3426224135},"darkThemeColorPalette":{"baseBackground":4280091138,"raisedBackground":4281862151,"additiveBackground":734611270,"textPrimary":4294696927,"textSecondary":4293305507,"invertedBackground":4293098877,"overlayBackground":3426224135},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egt5S05kN3pfWFhvbyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"681,633"},"label":{"simpleText":"Views"},"accessibilityText":"681,633 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566839110,"textPrimary":4281862151,"textSecondary":4286458666,"invertedBackground":4287568665,"overlayBackground":3426224135},"darkThemeColorPalette":{"baseBackground":4280091138,"raisedBackground":4281862151,"additiveBackground":734611270,"textPrimary":4294696927,"textSecondary":4293305507,"invertedBackground":4293098877,"overlayBackground":3426224135},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2024"},"label":{"simpleText":"20 Jan"},"accessibilityText":"20 Jan 2024","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566839110,"textPrimary":4281862151,"textSecondary":4286458666,"invertedBackground":4287568665,"overlayBackground":3426224135},"darkThemeColorPalette":{"baseBackground":4280091138,"raisedBackground":4281862151,"additiveBackground":734611270,"textPrimary":4294696927,"textSecondary":4293305507,"invertedBackground":4293098877,"overlayBackground":3426224135},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBkQ040EGAYiEwiZh4G3udaVAxU7pdgFHVEVBOHKAQSlCVUD","commandMetadata":{"webCommandMetadata":{"url":"/@topmusicretro9239","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCJpSwP0LMym6KxX4XqAXLTQ","canonicalBaseUrl":"/@topmusicretro9239"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/oG4YqiGt_Rp9p0lNmXZzfeP5atnfvFPy0PUIwnT_1E3VQgxit860cVeB3O-lusw_ESa85MJmUQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Hard rock or heavy rock[1] is a heavier subgenre of rock music typified by aggressive vocals and distorted electric guitars. Hard rock began in the mid-1960s with the garage, psychedelic and blues rock movements. Some of the earliest hard rock music was produced by the Kinks, the Who, the Rolling Stones, Cream, Vanilla Fudge, and the Jimi Hendrix Experience. In the late 1960s, bands such as Blue Cheer, the Jeff Beck Group, Iron Butterfly, Led Zeppelin, Golden Earring, Steppenwolf, Deep Purple and Grand Funk Railroad also produced hard rock.\nThe genre developed into a major form of popular music in the 1970s, with the Who, Led Zeppelin and Deep Purple being joined by Black Sabbath, Aerosmith, Kiss, Queen, AC/DC, Thin Lizzy and Van Halen. During the 1980s, some hard rock bands moved away from their hard rock roots and more towards pop rock.[2][3] Established bands made a comeback in the mid-1980s and hard rock reached a commercial peak in the 1980s with glam metal bands such as Mötley Crüe, Bon Jovi and Def Leppard as well as the rawer sounds of Guns N' Roses which followed with great success in the later part of that decade.","styleRuns":[{"startIndex":0,"length":1141,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":1141,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566839110,"textPrimary":4281862151,"textSecondary":4286458666,"invertedBackground":4287568665,"overlayBackground":3426224135},"darkThemeColorPalette":{"baseBackground":4280091138,"raisedBackground":4281862151,"additiveBackground":734611270,"textPrimary":4294696927,"textSecondary":4293305507,"invertedBackground":4293098877,"overlayBackground":3426224135},"colorSampledDescriptionBodyText":{"content":"Hard rock or heavy rock[1] is a heavier subgenre of rock music typified by aggressive vocals and distorted electric guitars. Hard rock began in the mid-1960s with the garage, psychedelic and blues rock movements. Some of the earliest hard rock music was produced by the Kinks, the Who, the Rolling Stones, Cream, Vanilla Fudge, and the Jimi Hendrix Experience. In the late 1960s, bands such as Blue Cheer, the Jeff Beck Group, Iron Butterfly, Led Zeppelin, Golden Earring, Steppenwolf, Deep Purple and Grand Funk Railroad also produced hard rock.\nThe genre developed into a major form of popular music in the 1970s, with the Who, Led Zeppelin and Deep Purple being joined by Black Sabbath, Aerosmith, Kiss, Queen, AC/DC, Thin Lizzy and Van Halen. During the 1980s, some hard rock bands moved away from their hard rock roots and more towards pop rock.[2][3] Established bands made a comeback in the mid-1980s and hard rock reached a commercial peak in the 1980s with glam metal bands such as Mötley Crüe, Bon Jovi and Def Leppard as well as the rawer sounds of Guns N' Roses which followed with great success in the later part of that decade.","styleRuns":[{"startIndex"