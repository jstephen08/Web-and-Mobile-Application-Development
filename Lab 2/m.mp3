artIndex":1949,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1950,"length":13,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1963,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1964,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566852422,"textPrimary":4281867015,"textSecondary":4286467114,"invertedBackground":4287580441,"overlayBackground":3426228999},"darkThemeColorPalette":{"baseBackground":4280093954,"raisedBackground":4281867015,"additiveBackground":734624582,"textPrimary":4294699743,"textSecondary":4293312163,"invertedBackground":4293109629,"overlayBackground":3426228999},"colorSampledDescriptionBodyText":{"content":"Some songs become more than music — they become memories. 🌅\n\nTravel back to the golden era of classic rock with this timeless collection of legendary songs that defined generations and continue to inspire listeners around the world.\n\nFeaturing unforgettable classics from Eagles, Pink Floyd, Led Zeppelin, Fleetwood Mac, The Beatles, Elton John, David Bowie, Supertramp and more.\n\nThese are the songs that filled radios, road trips, unforgettable nights and moments that still live with us today.\n\n🎸 Timeless Classic Rock\n🌅 Songs That Defined Generations\n🚗 Road Trip Memories\n📻 Legendary FM Classics\n✨ Music That Never Gets Old\n\nTurn up the volume and enjoy the soundtrack of an unforgettable era.\n\n⏱️ TIMESTAMPS\n\n00:00 — Eagles — Hotel California\n06:31 — Pink Floyd — Wish You Were Here\n12:05 — Led Zeppelin — Stairway to Heaven\n20:08 — Fleetwood Mac — Dreams\n24:26 — The Beatles — Here Comes The Sun\n27:33 — Elton John — Tiny Dancer\n33:51 — David Bowie — Space Oddity\n39:09 — Gerry Rafferty — Baker Street\n45:14 — David Bowie — Life On Mars?\n49:11 — Kansas — Dust In The Wind\n52:36 — Christopher Cross — Sailing\n56:52 — Supertramp — The Logical Song\n1:01:19 — Supertramp — Take The Long Way Home\n1:06:27 — Supertramp — Breakfast In America\n1:09:06 — Aerosmith — Dream On\n1:13:33 — David Bowie — Changes\n1:17:11 — America — Sister Golden Hair\n1:20:29 — America — A Horse With No Name\n\n🎸 Some generations had trends.\nThese songs became timeless.\n\nWhich one still gives you chills?\n\n🌅 Hotel California\n🌅 Stairway to Heaven\n🌅 Wish You Were Here\n🌅 Dreams\n\nTell us your favorite.\n\nclassic rock, golden classic rock, 70s rock, 80s hits, timeless classics, eagles hotel california, pink floyd classics, led zeppelin songs, fleetwood mac dreams, classic rock playlist, road trip music, soft rock classics, vintage rock, legendary hits, old school rock\n\n#ClassicRock #70sMusic #80sHits #GoldenRock #TimelessClassics #PinkFloyd #LedZeppelin #Eagles #FleetwoodMac #RoadTrip","commandRuns":[{"startIndex":719,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAgiEwjgmbertdaVAxWrmtgFHWCaDvTKAQSlCVUD","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=Ks_bS-ZHlVo","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"Ks_bS-ZHlVo","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr2---sn-nau-jhcd.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026siu=1\u0026msp=1\u0026odepv=1\u0026id=2acfdb4be647955a\u0026ip=203.115.31.111\u0026initcwndbps=1021250\u0026mt=1784177824\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTg3NTI5OQ\u0026rxtags=Cg4KAnR4Egg1MTg3NTI5OA%2CCg4KAnR4Egg1MTg3NTI5OQ%2CCg4KAnR4Egg1MTg3NTMwMA%2CCg4KAnR4Egg1MTg3NTMwMQ%2CCg4KAnR4Egg1MTg3NTMwMg"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 seconds"}}},{"s