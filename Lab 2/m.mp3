ctoidRenderer":{"value":{"simpleText":"199,930"},"label":{"simpleText":"Views"},"accessibilityText":"199,930 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566852422,"textPrimary":4281867015,"textSecondary":4286467114,"invertedBackground":4287580441,"overlayBackground":3426228999},"darkThemeColorPalette":{"baseBackground":4280093954,"raisedBackground":4281867015,"additiveBackground":734624582,"textPrimary":4294699743,"textSecondary":4293312163,"invertedBackground":4293109629,"overlayBackground":3426228999},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"10 Jun"},"label":{"simpleText":"2026"},"accessibilityText":"10 Jun 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566852422,"textPrimary":4281867015,"textSecondary":4286467114,"invertedBackground":4287580441,"overlayBackground":3426228999},"darkThemeColorPalette":{"baseBackground":4280093954,"raisedBackground":4281867015,"additiveBackground":734624582,"textPrimary":4294699743,"textSecondary":4293312163,"invertedBackground":4293109629,"overlayBackground":3426228999},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBwQ040EGAgiEwjgmbertdaVAxWrmtgFHWCaDvTKAQSlCVUD","commandMetadata":{"webCommandMetadata":{"url":"/@FlashbackDreams","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC8Qd5nREcOPc6l7uKcVaaaA","canonicalBaseUrl":"/@FlashbackDreams"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/8kZQmYDJ4CQqSVimRLr_wUPi7dh4s8xrsooyE33fAXLjFib6CQ6hJeyD6GMt82u9g1ecaQiMRg=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Some songs become more than music — they become memories. 🌅\n\nTravel back to the golden era of classic rock with this timeless collection of legendary songs that defined generations and continue to inspire listeners around the world.\n\nFeaturing unforgettable classics from Eagles, Pink Floyd, Led Zeppelin, Fleetwood Mac, The Beatles, Elton John, David Bowie, Supertramp and more.\n\nThese are the songs that filled radios, road trips, unforgettable nights and moments that still live with us today.\n\n🎸 Timeless Classic Rock\n🌅 Songs That Defined Generations\n🚗 Road Trip Memories\n📻 Legendary FM Classics\n✨ Music That Never Gets Old\n\nTurn up the volume and enjoy the soundtrack of an unforgettable era.\n\n⏱️ TIMESTAMPS\n\n00:00 — Eagles — Hotel California\n06:31 — Pink Floyd — Wish You Were Here\n12:05 — Led Zeppelin — Stairway to Heaven\n20:08 — Fleetwood Mac — Dreams\n24:26 — The Beatles — Here Comes The Sun\n27:33 — Elton John — Tiny Dancer\n33:51 — David Bowie — Space Oddity\n39:09 — Gerry Rafferty — Baker Street\n45:14 — David Bowie — Life On Mars?\n49:11 — Kansas — Dust In The Wind\n52:36 — Christopher Cross — Sailing\n56:52 — Supertramp — The Logical Song\n1:01:19 — Supertramp — Take The Long Way Home\n1:06:27 — Supertramp — Breakfast In America\n1:09:06 — Aerosmith — Dream On\n1:13:33 — David Bowie — Changes\n1:17:11 — America — Sister Golden Hair\n1:20:29 — America — A Horse With No Name\n\n🎸 Some generations had trends.\nThese songs became timeless.\n\nWhich one still gives you chills?\n\n🌅 Hotel California\n🌅 Stairway to Heaven\n🌅 Wish You Were Here\n🌅 Dreams\n\nTell us your favorite.\n\nclassic rock, golden classic rock, 70s rock, 80s hits, timeless classics, eagles hotel california, pink floyd classics, led zeppelin songs, fleetwood mac dreams, classic rock playlist, road