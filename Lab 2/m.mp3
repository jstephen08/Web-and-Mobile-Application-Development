Were Here\n🌅 Dreams\n\nTell us your favorite.\n\nclassic rock, golden classic rock, 70s rock, 80s hits, timeless classics, eagles hotel california, pink floyd classics, led zeppelin songs, fleetwood mac dreams, classic rock playlist, road trip music, soft rock classics, vintage rock, legendary hits, old school rock\n\n#ClassicRock #70sMusic #80sHits #GoldenRock #TimelessClassics #PinkFloyd #LedZeppelin #Eagles #FleetwoodMac #RoadTrip","commandRuns":[{"startIndex":719,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJgEEM2rARgBIhMI4Jm3q7XWlQMVq5rYBR1gmg70ygEEpQlVAw==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=Ks_bS-ZHlVo","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"Ks_bS-ZHlVo","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr2---sn-nau-jhcd.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026siu=1\u0026msp=1\u0026odepv=1\u0026id=2acfdb4be647955a\u0026ip=203.115.31.111\u0026initcwndbps=1021250\u0026mt=1784177824\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTg3NTI5OQ\u0026rxtags=Cg4KAnR4Egg1MTg3NTI5OA%2CCg4KAnR4Egg1MTg3NTI5OQ%2CCg4KAnR4Egg1MTg3NTMwMA%2CCg4KAnR4Egg1MTg3NTMwMQ%2CCg4KAnR4Egg1MTg3NTMwMg"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 seconds"}}},{"startIndex":753,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJgEEM2rARgBIhMI4Jm3q7XWlQMVq5rYBR1gmg70ygEEpQlVAw==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=Ks_bS-ZHlVo\u0026t=391s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"Ks_bS-ZHlVo","continuePlayback":true,"startTimeSeconds":391,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr2---sn-nau-jhcd.googlevideo.com/initplayback?source=youtube\u0